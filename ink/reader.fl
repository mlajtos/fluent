; Reading a line of ink
;
; A line is the strokes a pen made along one rule. This program says which
; strokes are one glyph, which glyph that is, and where the spaces are. It
; reads the ink as it stands on the page, not as it came: the strokes are
; taken left to right, whenever the pen made them. It is the PageReader of
; ink/page.py, with the weights it learned there.
;
;   1. even     a stroke becomes M points, evenly along it
;   2. seen     each stroke becomes a curve, and where it stands in the line
;   3. reader   one transformer reads each stroke, another the line of them
;   4. read     each stroke points at the first stroke of its glyph, and
;               the strokes of one glyph name it together
;
; Every line comes in one shape, so the engine plans its work once:
;   strokes [S, P, 2]   points, from where the rule starts; a stroke
;                       shorter than P is filled up with its last point
;   real    [S]         1 for the line's strokes – the first ones – else 0
;
; says: read(files) makes the readers of the files page.py kept, and
; says(strokes, real) is what they read: numbers [S, 5], told in part 4.


; 1. Even points
;
; A pen leaves many points where it is slow and few where it is fast. The
; shape of a stroke is its points at even steps: walk along the stroke and
; leave a mark at every n-th part of its length. A mark falls between two
; of the pen's points, on the straight line from one to the other.

M: 32,

; [S, P, 2] → [S, n, 2]
even: { strokes, n |
  P: shape(strokes)_1,
  step: slice(strokes, [0, 1]) - slice(strokes, [0, 0], [-1, P-1]),
  ; how far the pen has come at each point: [S, P], from 0 to the length
  walked: concat((fill([#strokes, 1], 0), TensorScan(√Σ(step × step, 2), +, 1)), 1),
  marks: slice(walked, [0, P-1]) × linspace([0, 1], n), ; [S, n]
  ; a mark that k+1 points are behind falls between points k and k+1
  k: clamp(Σ(unsqueeze(marks, 2) ≥ unsqueeze(walked, 1), 2) - 1, 0, P-2),
  ; those two, each as a row of 0s with one 1: such a row × the points is
  ; a point. [S, n, P]
  behind: oneHot(k, P),
  ahead: oneHot(k + 1, P),
  from: Σ(behind × unsqueeze(walked, 1), 2),
  to: Σ(ahead × unsqueeze(walked, 1), 2),
  part: marks - from ÷ (to - from ⌈ 1e-9), ; of the way between them, 0 to 1
  a: behind matmul strokes,
  b: ahead matmul strokes,
  a + (b - a × unsqueeze(part, 2))
},


; 2. What a reader sees of a stroke
;
;   curve  [n, T, 4]   its shape: the T control points of a curve through
;                      its M points, and the step from each to the next
;   whole  [n, 2]      how large it is, and how high over the rule
;   stands [n, 26]     where it stands: `whole` again, its box, how far it
;                      is from the stroke before it, and how far along the
;                      rule – as waves of nine lengths
;
; The curve is PIECES cubic Béziers end to end, each an equal part of the
; stroke: T control points in place of M points. A reader of curves reads
; as well as a reader of points, and learns 2.3 times as fast (page.py).

PIECES: 2,
T: 3×PIECES + 1,

; what each control point weighs at each of the M points: [M, T]
basis: {
  along: linspace([0, PIECES], M),
  piece: floor(along) ⌊ PIECES-1,
  u: unsqueeze(along - piece, 1), ; how far into its piece a point is
  j: 0..<T - unsqueeze(3×piece, 1), ; a control point's number in that piece
  c: clamp(j, 0, 3),
  ; Bernstein's cubics, for the piece's four control points; 0 for the rest
  (j = c) × [1, 3, 3, 1]_c × u^c × (1-u)^(3-c)
}(),

; The curve nearest M points has the control points fit × points, with
; fit = (BᵀB)⁻¹Bᵀ, [T, M] – least squares. The inverse is Gauss–Jordan's:
; BᵀB with Bᵀ beside it, and one column after another of the left half
; cleared to the identity's. The right half is then the fit.
fit: {
  Bᵀ: transpose(basis),
  cleared: fold(0..<T, { A, k |
    pivot: A_k ÷ A_k_k,
    A - (transpose(A)_k - (0..<T = k) ⊗(×) pivot)
  }, concat((Bᵀ matmul basis, Bᵀ), 1)),
  slice(cleared, [0, T])
}(),

FLOOR: 8, ; the least size of a stroke's box: a dot stays a dot
TURNS: 0.5 × 2^(0..<9), ; the waves' lengths, each × 32 units

; ink [n, M, 2], the strokes left to right → (curve, whole, stands)
seen: { ink |
  n: #ink,
  low: min(ink, 1),
  high: max(ink, 1), ; [n, 2]: the corners of each stroke's box
  middle: low + high ÷ 2,
  size: max(high - low, 1) ⌈ FLOOR, ; [n]: the box's longer side
  ; the stroke in its own box – its middle at 0, its size 1 – as a curve
  control: fit matmul (ink - unsqueeze(middle, 1) ÷ (size ⍴ [n, 1, 1])),
  step: control - concat((slice(control, [0, 0], [-1, 1]), slice(control, [0, 0], [-1, T-1])), 1),
  whole: stack((log(size ÷ 32), transpose(middle)_1 ÷ 32), 1),
  ; How far it is from the stroke before it: from that one's end to its
  ; start, and to its left edge from that one's right edge, and from the
  ; rightmost edge so far. The first stroke has none before it, and 0s.
  first: slice(ink, [0, 0], [-1, 1]) ⍴ [n, 2],
  last: slice(ink, [0, M-1], [-1, 1]) ⍴ [n, 2],
  leftEdge: drop(transpose(low)_0, 1),
  rightEdge: transpose(high)_0,
  fromEnd: drop(first, 1) - drop(last, -1), ; [n-1, 2]
  fromEdge: leftEdge - drop(rightEdge, -1),
  fromRightmost: leftEdge - drop(scan(rightEdge, ⌈), -1),
  gap: concat((fill([1, 4], 0), concat((fromEnd, stack((fromEdge, fromRightmost), 1)), 1)), 0),
  turn: 2×π × slice(middle, [0, 0], [-1, 1]) ÷ 32 ÷ TURNS, ; [n, 9]
  (
    concat((control × 2, step × T÷4), 2),
    whole,
    concat((whole, high - low ÷ 32, gap ÷ 16, sin(turn), cos(turn)), 1),
  )
},


; 3. The readers
;
; A reader is two transformers.
;   – One reads a stroke: its T control points and, before them, one more
;     token made of `whole`. What that token comes to is the stroke's
;     vector.
;   – One reads the line: the strokes' vectors, each with where it stands.
;     Nothing tells it when a stroke was made.
; Each stroke's vector then answers three questions: which glyph is it of,
; what is it to the glyph before – FIRST, SPACED or neither, a later
; stroke – and which stroke of the line does its glyph start with.
;
; R readers read as one: what each finds likely is multiplied, so their
; logs are added. Every weight of all R is stacked along a first axis and
; a line goes through all of them at once – [R, n, 1 + T, d] in a stroke,
; [R, 1, n, d] in the line.
;
; `files` is of each reader what page.py kept, a list of (name, tensor):
; its weights by the names MLX has for them, and `glyphs`, the code points
; of the alphabet it reads.

; where a file keeps a name; the readers' files keep the same names at the
; same places
spot: { file, name | argmax(stack(ListMap(file, { pair | pair_0 ≡ name }))) },
; what one file keeps under a name, and what all of them do: [R, …]
held: { file, name | ListGet(file, spot(file, name))_1 },
kept: { files, name |
  at: spot(files_0, name),
  stack(ListMap(files, { file | ListGet(file, at)_1 }))
},

HEADS: 4,

reader: { files |
  R: ListLength(files),
  ; a weight as a matrix that rows are multiplied by, [R, 1, in, out], or
  ; as a row added to them, [R, 1, 1, out]
  matrix: { name | unsqueeze(permute(kept(files, name), [0, 2, 1]), 1) },
  row: { name | kept(files, name) ⍴ [R, 1, 1, -1] },

  ; The layers. Each is made of its name in the files, and is a function
  ; of the tokens x.
  linear: { name |
    W: matrix(name ++ ".weight"),
    b: row(name ++ ".bias"),
    { x | x matmul W + b }
  },
  ; each token with mean 0 and variance 1, then scaled and moved
  normed: { name |
    gain: row(name ++ ".weight"),
    bias: row(name ++ ".bias"),
    { x |
      y: x - μ(x, -1, 1),
      y ÷ √(μ(y × y, -1, 1) + 1e-5) × gain + bias
    }
  },
  ; Attention. Every token asks a query and offers a key and a value, and
  ; takes of the others' values as much as its query fits their keys.
  ; HEADS heads do so apart, each on its own part of the vector. `none` is
  ; added to the fit: -1e9 at a token nothing may look at.
  attention: { name |
    Q: matrix(name ++ ".query_proj.weight"),
    K: matrix(name ++ ".key_proj.weight"),
    V: matrix(name ++ ".value_proj.weight"),
    O: matrix(name ++ ".out_proj.weight"),
    d: shape(Q)_2,
    ; [R, n, t, d] → [R, n, HEADS, t, d÷HEADS]
    apart: { x | permute(x ⍴ (take(shape(x), 3) ++ [HEADS, -1]), [0, 1, 3, 2, 4]) },
    { x, none |
      q: apart(x matmul Q),
      k: apart(x matmul K),
      v: apart(x matmul V),
      fits: q matmul permute(k, [0, 1, 2, 4, 3]) ÷ √(d ÷ HEADS), ; [R, n, HEADS, t, t]
      taken: softmax(fits + none) matmul v,
      permute(taken, [0, 1, 3, 2, 4]) ⍴ shape(x) matmul O
    }
  },
  gate: { x | x × 0.5 × (1 + erf(x ÷ (√2))) }, ; GELU, exactly as MLX has it
  ; A block: the tokens look at each other, then each thinks on its own.
  ; Both times, what comes of it is added to what went in.
  block: { name |
    norm1: normed(name ++ ".before"),
    look: attention(name ++ ".attend"),
    norm2: normed(name ++ ".after"),
    widen: linear(name ++ ".wide"),
    narrow: linear(name ++ ".narrow"),
    { x, none |
      y: x + look(norm1(x), none),
      y + (y . norm2 . widen . gate . narrow)
    }
  },
  pass: { x, blocks, none | fold(blocks, { x, block | block(x, none) }, x) },

  ; The reader: its layers, by their names in page.py
  ofWhole: linear("whole"),
  ofPoint: linear("point"),
  place: unsqueeze(kept(files, "place"), 1), ; which token of a stroke is which
  inStroke: ListMap(("stroke.0", "stroke.1"), block),
  ofStanding: linear("where"),
  inLine: ListMap(("line.0", "line.1", "line.2", "line.3"), block),
  final: normed("norm"),
  glyph: linear("glyph"),
  role: linear("role"),
  asks: linear("asks"),
  answers: linear("answers"),
  agreed: { x | Σ(logSoftmax(x), 0)_0 }, ; the readers as one

  ; given: what `seen` makes of the strokes; none: [n], -1e9 at the strokes
  ; that are not the line's. Of each stroke, the log of how likely each
  ; glyph is, each role, and each stroke as the first of its glyph.
  { given, none |
    curve: given_0,
    whole: given_1,
    stands: given_2,
    n: #curve,
    tokens: concat((ofWhole(unsqueeze(whole, 1)), ofPoint(curve)), 2) + place,
    vector: slice(pass(tokens, inStroke, 0), [0, 0, 0], [-1, -1, 1]) ⍴ [R, 1, n, -1],
    y: final(pass(vector + ofStanding(stands), inLine, none)),
    ; a stroke's glyph starts with the stroke whose answer fits its question
    fits: asks(y) matmul permute(answers(y), [0, 1, 3, 2]) ÷ √(shape(place)_3),
    (
      agreed(glyph(y)),
      agreed(role(y)),
      agreed(fits + none),
    )
  }
},


; 4. Reading
;
; The readers say of each stroke which stroke its glyph starts with: a
; link. A glyph's first stroke links to itself, so the links from any
; stroke end at the first stroke of its glyph. The strokes whose links end
; at one stroke are one glyph, and what they say of its name is added up.
;
; says(strokes, real) is [S, 5]. Its first column is of the strokes, as
; the pen made them; the others are of the places in the line, left to
; right:
;   0   which glyph of the text the stroke is of
;   1   whether a glyph starts at this place
;   2   whether that glyph comes after a space
;   3   its code point
;   4   how sure the readers are of it, 0 to 1

FIRST: 1, SPACED: 2,

read: { files |
  says: reader(files),
  glyphs: kept(files, "glyphs")_0,
  { strokes, real |
    S: #strokes,
    i: 0..<S,
    ink: even(strokes, M),
    ; Left to right: by where each stroke begins on the left, the higher
    ; first of two that begin together. Strokes not the line's come last.
    corner: transpose(min(ink, 1)), ; of each stroke's box: its left, its top
    higher: argsort(corner_1),
    order: higher_(argsort(where(real, corner_0, 1e9)_higher)),
    mine: real_order,
    said: says(seen(ink_order), 1-mine × -1e9),
    ; Where the links end. All strokes follow theirs at once, each round
    ; twice as far as the last – seven rounds pass 128 strokes – and mind
    ; the leftmost stroke they pass: links that go round in a ring end
    ; nowhere, and such a glyph starts at its leftmost stroke.
    to: argmax(said_2, -1),
    follow: { state |
      jump: state_0,
      leftmost: state_1,
      (jump_jump, leftmost ⌊ leftmost_jump)
    },
    walk: (follow ⍣ 7)((to, i)),
    end: walk_0,
    start: where(to_end = end, end, walk_1), ; the first stroke of each stroke's glyph
    ; [stroke, place]: 1 where the stroke's glyph starts at the place
    of: (start ⊗(=) i) × unsqueeze(mine, 1),
    starts: max(of, 0),
    nth: scan(starts, +) - 1, ; which glyph of the text starts at a place
    named: transpose(of) matmul said_0, ; [place, glyph]: its strokes' logs, added
    played: transpose(said_1),
    spaced: (played_SPACED > played_FIRST) × (nth > 0) × starts,
    stack((
      nth_start_(argsort(order)),
      starts,
      spaced,
      glyphs_(argmax(named, -1)),
      ; the share the likeliest name has among all names. The readers'
      ; product says 1 of nearly every glyph, right or wrong: its R-th root
      1 ÷ Σ(exp(named - max(named, -1, 1) ÷ ListLength(files)), -1),
    ), 1)
  }
},

; what says(strokes, real) said, as (the text, of each stroke which glyph
; of the text it is of, how sure of each glyph)
told: { said, real |
  s: transpose(said),
  (
    CodesToString(mask(flat(stack((fill([#said], 32), s_3), 1)), flat(stack((s_2, s_1), 1)))),
    mask(s_0, real),
    mask(s_4, s_1),
  )
},
