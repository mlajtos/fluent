; einsum(spec, a, b) in Fluent — the prelude definition that replaces the native binding
; once the engine computes constant-only values while building (OwnEngine.md §6.3).
; Matches the native einsum on 17 patterns (matmul, batched, attention, outer, transpose,
; full contraction, diagonal/trace, implicit output, "..." broadcasting) and its ∇.
; One or two operands; more → an Error (contract in steps).
einsum: { spec, a, b |
  ; where each label first appears in v
  firstOf: { v | k: 0 ..< #(v), min(where(v ⊗(=) v, k ⊗(⊢) k, #(v)), 1) },
  ; for each label in l, its position in set
  posIn: { l, set | Σ((l ⊗(=) set) × (0 ..< #(set)), 1) },
  ; move the axes to the end in the order perm lists them; an axis still
  ; waiting sits at its original index, minus those already moved
  permute: { x, perm | k: 0 ..< #(perm),
    ListReduce(unstack(k), { y, i | p: perm_i, moveaxis(y, p - Σ((k < i) × (perm < p)), -1) }, x) },
  ; "..." stands for the axes nobody labelled, numbered from the right
  ; so they line up the way broadcasting does
  expand: { l, e | dots: min(where(l = 46, 0 ..< #(l), #(l))),
    cond(guard(dots < #(l), { concat((slice(l, [0], [dots]), 256 + reverse(0 ..< e), slice(l, [dots + 3], [-1]))) }), { l }) },
  codes: StringToCodes(spec),
  n: #(codes),
  arrow: min(where(codes = 45, 0 ..< n, n)),
  ins: slice(codes, [0], [arrow]),
  commas: mask(0 ..< arrow, ins = 44),
  starts: concat(([0], commas + 1)),
  ends: concat((commas, [arrow])),
  xs: cond(guard(#(commas) = 0, { List(a) }), { (a, b) }),
  ls: ListMap(unstack(0 ..< #(xs)), { g | l: slice(ins, [starts_g], [ends_g - starts_g]), expand(l, #(shape(ListGet(xs, g))) - (#(l) - 3)) }),
  all: concat(ls),
  u: mask(all, firstOf(all) = (0 ..< #(all))),
  e: Σ(u ≥ 256),
  ; without an arrow: the broadcast axes, then every label used once, alphabetically
  lo: cond(guard(arrow < n, { expand(slice(codes, [arrow + 2], [-1]), e) }),
    { concat((256 + reverse(0 ..< e), sort(mask(u, (Σ(all ⊗(=) u, 0) = 1) ∧ (u < 256))))) }),
  ; a label written twice in one operand ("ii") reads its diagonal
  diag: { x, l |
    k: 0 ..< #(l),
    first: firstOf(l),
    again: mask(k, first ≠ k),
    cond(guard(#(again) = 0, { (x, l) }), {
      along: { j | (0 ..< (shape(x)_j)) ⍴ where(k = j, shape(x)_j, 1) },
      δ: ListReduce(unstack(again), { d, j | d × (along(j) = along(first_j)) }, 1),
      (Σ(x × δ, again), mask(l, first = k))
    })
  },
  ; each operand, a repeated label already read off its diagonal, and
  ; its size along every label – 0 where it lacks one
  ops: ListMap(unstack(0 ..< #(xs)), { g | diag(ListGet(xs, g), ListGet(ls, g)) }),
  sizes: stack(ListMap(ops, { p | Σ((u ⊗(=) ListGet(p, 1)) × shape(ListGet(p, 0)), 1) })),
  cond(
    guard(#(commas) > 1, { Error("einsum: one or two operands – contract more in steps", spec) }),
    guard(¬(min((sizes ≤ 1) ∨ (sizes = max(sizes, 0)))), { Error("einsum: a label's axes differ in size", spec) }),
    {
      ; each operand with its axes in u's order, a size-1 axis for each label it lacks
      z: ListReduce(ListMap(unstack(0 ..< #(xs)), { g |
        p: ListGet(ops, g),
        permute(ListGet(p, 0), ⍋(posIn(ListGet(p, 1), u))) ⍴ where(sizes_g > 0, sizes_g, 1)
      }), { p, q | p × q }),
      ; the output's labels first, in its order, then the ones summed away
      keep: Σ(u ⊗(=) lo, 1) > 0,
      Σ(permute(z, ⍋(where(keep, posIn(u, lo), #(lo) + (0 ..< #(u))))), #(lo) ..< #(u))
    }
  )
},
