; each glyph's edges, [glyphs + 1, E, 5], as DrawEdges gives them. A contour's first point
; is an edge of no length, and edges far away fill each glyph out to the most any has – all
; of them for the blank one. Worked out on first use and kept as data, so a drawing reads
; it rather than works it out
DrawFontEdges: memo({
  v: Σ(StringToCodes(DrawFontPoints) - 35 ⍴ [-1, 2, 2] × [92, 1], -1),
  q: v % 4232 ÷ 1000,
  edges: DrawEdges(where(unsqueeze(transpose(v)_0 ≥ 4232, -1), q, concat((q_[0], drop(q, -1)))), q),
  s: concat((DrawFontStarts, DrawFontStarts_[-1])), c: drop(s, 1) - drop(s, -1), j: 0..<max(c),
  SignalRead(~~where(unsqueeze(c ⊗(>) j, -1), edges_(drop(s, -1) ⊗(+) j ⌊ (length(q) - 1)), [1000, 1000, 1000, 1000, 0]))
}),
letters: DrawLetters: doc({ s, at, size |
  codesOf: { t | cond(guard(isString(t), { StringToCodes(t) }), { t }) },
  texts: cond(guard(isList(s), { ListMap(s, codesOf) }), { (codesOf(s),) }),
  ; a row of codes for each text, filled out with spaces to one length
  n: max(stack(ListMap(texts, { t | #t }))) ⌈ 1,
  codes: stack(ListMap(texts, { t | concat((t, fill([n - (#t)], 32))) })),
  ; each code's glyph is its place among the font's codes, which are sorted, and past
  ; them a blank one for each code the font lacks, as it lacks a space
  font: StringToCodes(DrawFontCodes), blank: length(font),
  i: Σ(codes ⊗(>) font, -1) ⌊ (blank - 1),
  glyph: flat(where(font_i = codes, i, blank)),
  corners: at ⍴ [-1, 2], m: #corners,
  ; From p, at D of the display's pixels a unit. Each text's distance is worked out at the
  ; pixels where it lies – a block of them a pixel wider than its line all round,
  ; [m, R, C], from the pixel o – and read from there
  measure: { p, D |
    R: ceil(1.2 × size × D) + 2, C: ceil(0.6 × n × size × D) + 2,
    o: floor(corners × D) - 1,
    ; each block pixel's center in ems from its text's corner; the cell it lies in, and the
    ; cell beside it on its side – the nearer of their glyphs' outlines counts
    u: moveaxis(stack(meshgrid(0..<C + 0.5, 0..<R + 0.5), -1) + (o ⍴ [m, 1, 1, 2]) ÷ D - (corners ⍴ [m, 1, 1, 2]) ÷ size, -1, 0),
    ux: unsqueeze(u_0, -1), a: floor(ux ÷ 0.6),
    k: concat((a, where(ux ÷ 0.6 - a < 0.5, a - 1, a + 1)), -1) ⌈ 0 ⌊ n-1,
    ; the pixel from the outline of each of those glyphs, negative inside it
    e: moveaxis(DrawFontEdges()_(glyph_(0..<m × n ⍴ [m, 1, 1, 1] + k)), -1, 0),
    field: flat(min(DrawSides(unsqueeze(ux - 0.6×k, -1), u_1 ⍴ [m, R, C, 1, 1], e)_1, -1) × size),
    ; p in pixels from each block's first center, held inside the block, and how far past
    ; it p lies; the distance between the four block pixels around it, and past them – to
    ; the nearest of the texts
    q: unsqueeze(p, -2) × D - o - 0.5,
    h: clamp(q, 0, [C - 1, R - 1]), beyond: norm(q - h, -1) ÷ D,
    f: floor(h ⌊ [C - 2, R - 2]), g: moveaxis(h - f, -1, 0), z: moveaxis(f, -1, 0),
    read: { dx, dy | field_(0..<m × R + z_1 + dy × C + z_0 + dx) },
    min(read(0, 0) × 1-g_0 + (read(1, 0) × g_0) × 1-g_1 + (read(0, 1) × 1-g_0 + (read(1, 1) × g_0) × g_1) + beyond, -1)
  },
  ; the density is a live value; measure works with it as it is now
  { p | measure(p, Density()) }
}, "letters(text, at, size)", "The shape of a line of text in the IDE's font at a font size of size units, from its top-left corner at: a character is 0.6 × size wide and the line 1.2 × size tall. From p, the distance to the outline of the nearest glyph, negative inside it – so solid(color) fills the text, a stroke draws its outline, and a halo makes it glow. It is worked out exactly at the display's pixels around the text, and read between them. A character the font lacks is left blank. text may be character codes, or a list of texts with a row of at for each.", "canvas(100, 16) . paint(letters(\"letters 2.5\", [4, 1], 12), solid([1, 1, 1]))"),
; x as the codes of 3 significant digits – "2.31", "−0.0520", "1200" – with an exponent
; from 10 million up and below 0.001 – "1.50e9", "4.20e−5" – and NaN, ∞ and −∞ as such,
; spaces filling 9 cells, a row of them for each number in x. Arithmetic only, so it
; never waits for x to be read back
DrawDigits: { x |
  ; a number on each row, a cell in each column
  v: x ⍴ [-1, 1], a: abs(v),
  P: [1, 10, 100, 1000, 10000, 100000, 1000000],
  ; ⌊log₁₀ a⌋ from -37, where 0.9995 counts as 1, since it shows as 1.00; 10^-38 is
  ; too small for f32 to hold in full, and a GPU reads it as 0
  e: Σ(10^(0..<75 - 36) × 0.9995 < a, -1, 1) - 37,
  ; from 10 million up and below 0.001, an exponent – and two decimals after the first
  ; digit; a whole number has none
  sci: e>6 ⌈ (e < -3 × 0<a),
  d: where(sci, 2, clamp(2 - e, 0, 5) × (a ≠ round(a))),
  m: round(where(sci, a ÷ 10^e × 100, a × P_d)),
  n: Σ(P - 0.5 < m, -1, 1) ⌈ (d + 1),
  point: n - d,
  j: 0..<9 - (v < 0),
  t: j - (d>0 × j>point),
  ; the code of the digit of y, a whole number, worth 10 to the power p
  at: { y, p | r: floor(y + 0.5 ÷ P_clamp(p, 0, 6)), 48 + r - (floor(r ÷ 10) × 10) },
  ; after the digits, an exponent: e, its sign if negative, and its one or two digits
  k: t - n, E: abs(e), w: 1 + (e < 0) + (E > 9),
  power: where(k = 0, 101, where(e<0 × k=1, 8722, at(E, w - k))),
  shown: where(j < 0, 8722, where(d>0 × j=point, 46, where(t < n, at(m, n-1 - t), where(sci × (k < w+1), power, 32)))),
  where(isNaN(v), StringToCodes("NaN      "), where(a = 1÷0, where(j < 0, 8722, where(j = 0, 8734, 32)), shown)) ⍴ concat((shape(x), [9]))
},
; the shape of the line through the points (u, v), u ascending from u = from to u = to, for
; a stroke width units wide. Each column half a unit wide keeps five points – where the
; line enters it, then its first, top, bottom and last points, in the order the line passes
; them – so drawing it costs what the columns do, however many points it has, and its
; stroke looks the same as one through every point. p is measured only to the columns a
; stroke at p reaches
DrawTrace: { u, v, from, to, width |
  n: #u,
  ; each point's column, and the points in each column, [C, n]
  c0: floor(from × 2), C: floor(to × 2) - c0 + 1,
  c: clamp(floor(u × 2) - c0, 0, C - 1),
  in: 0..<C ⊗(=) c,
  ; how many points fall before each column and in it; its first and last points – the
  ; last point of all when it has none – and the first of its points at its top and bottom,
  ; a point outside the column moved past every value and every index
  start: Σ(0..<C ⊗(>) c, 1), count: Σ(in, 1),
  first: start ⌊ n-1, last: start + count - 1 ⌈ 0,
  earliest: { e | hit: in×(v = (e ⍴ [C, 1])), min(0..<n + (1 - hit)×n, 1) ⌊ n-1 },
  top: earliest(min(v + (1 - in)×1e30, 1)), bottom: earliest(max(v + (in - 1)×1e30, 1)),
  ; where the line enters each column, on its way from the point before the column
  at: { i | stack((u_i, v_i), -1) },
  edge: c0 + 0..<C ÷ 2, before: start - 1 ⌈ 0,
  f: clamp(edge - u_before ÷ (u_first - u_before ⌈ 1e-9), 0, 1),
  enter: at(before) + (f ⍴ [C, 1] × (at(first) - at(before))) ⍴ [C, 1, 2],
  ; five points a column, in order; a column no point falls in is where the line crosses it
  own: at(stack((first, top ⌊ bottom, top ⌈ bottom, last), -1)),
  points: concat((enter, where(count ⍴ [C, 1, 1] > 0, own, enter)), 1) ⍴ [-1, 2],
  ; draw reads a shape out to half the stroke's width and half a pixel, K columns each side:
  ; near_(5×k) is column k's window, the points of the K columns before it, its own, the K
  ; after it and the next one's first, as x and y – past the ends, the end points again
  K: ceil(width + (1 ÷ Density())), S: 5×(2×K + 1),
  ends: concat((fill([5×K, 2], 1) × points_0, points, fill([5×K + 5, 2], 1) × points_(-1))),
  near: moveaxis(window(transpose(ends), [S + 1]), 1, 0),
  { p |
    q: unstack(moveaxis(p, -1, 0)),
    ; the window of p's column: the x and the y of its points, […, S+1] each
    w: unstack(moveaxis(near_(5 × clamp(floor(q_0 × 2) - c0, 0, C - 1)), -2, 0)),
    ; each segment, from point j of the window to point j + 1, and p from either end. The
    ; segment's point nearest p is its start where p lies before it, its end where p lies
    ; past it – along runs from 0 at the start to L at the end – and p's foot between them
    x: unstack(window(w_0, [S]), -2), y: unstack(window(w_1, [S]), -2),
    dx: x_1 - x_0, dy: y_1 - y_0, L: dx^2 + dy^2,
    ux: unsqueeze(q_0, -1), uy: unsqueeze(q_1, -1),
    ax: ux - x_0, ay: uy - y_0, bx: ux - x_1, by: uy - y_1,
    along: ax×dx + ay×dy,
    min(where(along > 0, where(along < L, abs(ax×dy - ay×dx) ÷ √(L), √(bx^2 + by^2)), √(ax^2 + ay^2)), -1)
  }
},
plot: DrawPlot: doc({ x, ys, names |
  rows: cond(guard(isList(ys), { stack(ys) }), guard((#shape(ys)) = 1, { ys ⍴ [1, -1] }), { ys }),
  k: #rows, n: shape(rows)_1,
  ; the picture, and the box the data fills
  W: 520, H: 160, L: 68, R: 404, T: 8, B: 136,
  cond(guard(n < 2, { canvas(W, H) }), {
    ; the points padded to a power of two with the last one again, their count as data: a
    ; plot that grows a point at a time keeps its plan until its length doubles
    pad: 0 ..< 2^ceil(log2(n)) ⌊ (shape(x) - 1),
    px: x_pad, N: #px,
    py: cond(guard(isList(ys), { stack(ListMap(ys, { y | y_pad })) }), { transpose(transpose(rows)_pad) }),
    ink: [0.765, 0.761, 0.718], faint: [0.537, 0.529, 0.506],
    colors: [[0.224, 0.529, 0.898], [0.851, 0.349, 0.149], [0.098, 0.62, 0.439], [0.788, 0.522, 0], [0.835, 0.318, 0.506], [0, 0.514, 0], [0.565, 0.522, 0.914], [0.902, 0.404, 0.404]],
    lo: min(py), hi: max(py),
    sx: { v | v - px_0 ÷ (px_(-1) - px_0 ⌈ 1e-9) × (R - L) + L },
    sy: { v | hi - v ÷ (hi - lo ⌈ 1e-9) × (B - T) + T },
    ; a range frame: each axis spans the data, labeled at its ends – at a font size of 12, a
    ; character 7.2 wide and a digit's middle 7 below the top
    ends: DrawDigits([hi, lo, px_0, px_(-1)]), w: Σ(ends ≠ 32, -1) × 7.2,
    corners: [[L - 10 - w_0, T - 7], [L - 10 - w_1, B - 7], [L, B + 9], [R - w_3, B + 9]],
    ; each line labeled at its end with its name and last value, the labels pushed apart
    ; so they never overlap
    last: slice(py, [0, N-1]) ⍴ [k],
    order: argsort(sy(last)),
    steps: 0..<k × 13,
    at: (scan(sy(last)_order - steps, ⌈) + steps)_argsort(order),
    values: DrawDigits(last),
    words: ListMap(unstack(0..<k), { i |
      cond(guard(isList(names), { concat((StringToCodes(names_i), [32], values_i)) }), { values_i })
    }),
    frame: canvas(W, H)
      . draw(line([[L - 6, T], [L - 6, B]]), faint, 1)
      . draw(line([[L, B + 6], [R, B + 6]]), faint, 1)
      . paint(letters(unstack(ends), corners, 12), solid(faint)),
    fold(0..<k, { pic, i | pic . draw(DrawTrace(sx(px), sy(py_i), L, R, 1.25), colors_(i % 8), 1.25) }, frame)
      . paint(letters(words, stack((fill([k], R + 8), clamp(at - 7, 0, H - 14)), -1), 12), solid(ink))
  })
}, "plot(x, ys, names?)", "Lines on one pair of axes, a picture 520 × 160 units: ys is a list of vectors, or a matrix of rows, each over the points x, in ascending order. Each axis spans the data and is labeled at its ends; each line is labeled at its end with its name and last value. However many points a line has, it costs what the picture's width does: in each column half a unit wide, it keeps its first, top, bottom and last points.", "plot(0..<10, (0..<10, 9 - 0..<10), (\"up\", \"down\"))"),

; Optimization
; Optimizers. A step differentiates the loss with respect to the variables it reads –
; ∇(loss)() gives (value, variables, gradients) – and moves each variable against its
; gradient. A list after the hyperparameters trains just those variables, each a ~ the
; loss reads. What an optimizer remembers lives in data slots, one set per variable,
; made when it first sees its variables; := commits variables and slots in one pass.
TensorOptimizerStep: { loss, only |
  r: (∇loss)(),
  cond(guard(isError(r), { r }), {
    vs: r_1, gs: r_2, n: #vs,
    among: { o, list | ListReduce(ListMap(list, { v | identical(o, v) }), { p, q | p ⌈ q }, 0) },
    cond(
      guard(n = 0, { Error("no trainable variables – the loss reads no ~ variable") }),
      guard(isList(only), {
        cond(
          guard(ListReduce(ListMap(only, { o | 1 - among(o, vs) }), { p, q | p ⌈ q }, 0), {
            Error("a listed variable isn't a ~ the loss reads – a ~~ slot holds data, and nothing trains it")
          }),
          {
            ; in the list's order, which is the order of the memory made for them
            at: ListMap(only, { o | ListReduce(ListMap(vs, { v, i | identical(o, v) × i }), { p, q | p + q }, 0) }),
            (r_0, only, gs_at)
          }
        )
      }),
      { r }
    )
  })
},
; the slots a step keeps for its variables, made again when the variables change. It
; reads and writes the signal that holds them, so it must not be lifted
TensorOptimizerSlots: FunctionNoAutoLift({ held, vs, make |
  h: held(),
  same: cond(
    guard(identical(h, ◌), { 0 }),
    guard((#h_0) ≠ (#vs), { 0 }),
    { ListMap(vs, { v, i | identical(v, h_0_i) }) reduce ∧ }),
  cond(guard(same, { h_1 }), { fresh: ListMap(vs, { v | make(v) }), held((vs, fresh)), fresh })
}),
; Making an optimizer makes its memory, and a step writes it: both are occurrences,
; which take their arguments as they are – a live rate is read at each step.
optimizer: Optimizer: doc(FunctionNoAutoLift({ init, rule, lr, only |
  ; a variable's memory: its step count, then its slots
  memory: { v | TensorMemoryOf(v, init, { (~~0,) concat ListMap(init(v), { x | ~~x }) }) },
  ; given its variables, it makes their memory at once, so := can restore it before a step
  held: $cond(guard(isList(only), { (only, ListMap(only, memory)) }), ◌),
  step: { loss |
    s: TensorOptimizerStep(loss, only),
    cond(guard(isError(s), { s }), {
      vs: s_1, gs: s_2,
      slots: TensorOptimizerSlots(held, vs, memory),
      t: slots_0_0 + 1,
      rate: cond(guard(isFunction(lr), { lr(t) }), { lr }),
      norm: √ListReduce(ListMap(gs, { g | Σ(g × g) }), { p, q | p + q }),
      next: ListMap(vs, { v, i | rule(gs_i, v, drop(slots_i, 1), t, rate, norm) }),
      ; each variable, its step count and its slots, assigned together
      concat(ListMap(vs, { v, i | (v,) concat slots_i }))
        := concat(ListMap(next, { n | (n_0, t) concat n_1 })),
      s_0
    })
  },
  ; with no loss, what it remembers: every variable's memory, one list of ~~ slots
  ; a step is an occurrence: it reads its variables now and writes them
  FunctionNoAutoLift({ loss | cond(guard(identical(loss, ◌), { cond(guard(identical(held(), ◌), { List() }), { concat(held()_1) }) }), { step(loss) }) })
}), "optimizer(init, rule, lr, vars?)", "Make an optimizer from its rule. init(v) gives a variable's slots (a list of tensors); rule(g, v, slots, t, lr, norm) gives (v′, slots′) – the variable's next value and its slots'. t counts steps from 1, norm is the gradient's norm over every variable, and lr is a number or a schedule – a function of t. opt(loss) takes a step; opt() is what it remembers – each variable's step count and slots, as one list of ~~ data slots to save with the weights and restore with :=. Given its variables, it has that memory from the start.", "opt: optimizer({ v | List() }, { g, v, s, t, lr | (v - lr×g, List()) }, 0.1)"),
zerosLike: TensorZerosLike: doc({ v | fill(shape(v), 0) }, "zerosLike(x)", "Zeros in x's shape.", "zerosLike([1, 2, 3]) = [0, 0, 0]"),
; the hyperparameters a constructor takes: a number in place of the default, and a
; trailing list picks the variables to train
TensorOptimizerArg: { a, default | cond(guard(isTensor(a), { a }), { default }) },
TensorOptimizerVars: { a, b, c | cond(guard(isList(a), { a }), guard(isList(b), { b }), { c }) },
; scale a gradient down so the norm over every variable is at most c, then run the rule
clipNorm: OptimizerClipNorm: doc({ rule, c | { g, v, s, t, lr, norm | rule(g × (c ÷ (norm ⌈ c) ⌊ 1), v, s, t, lr, norm) } },
  "clipNorm(rule, c)", "A rule with its gradient clipped: scaled so its norm over every variable is at most c.", "opt: optimizer(adamInit, clipNorm(adamRule(0), 1), 0.01)"),
; schedules – functions of the step t, for lr
warmup: ScheduleWarmup: doc({ peak, steps | { t | peak × (t ÷ steps ⌊ 1) } }, "warmup(peak, steps)", "A learning rate rising linearly to peak over the first steps, then staying.", "opt: adam(warmup(0.01, 100))"),
cosine: ScheduleCosine: doc({ peak, steps | { t | peak × 0.5 × (1 + cos(π × (t ⌊ steps ÷ steps))) } }, "cosine(peak, steps)", "A learning rate falling from peak to 0 along half a cosine over steps, then staying at 0.", "opt: adam(cosine(0.01, 1000))"),

sgd: OptimizerSGD: doc(FunctionNoAutoLift({ lr, a, b |
  momentum: TensorOptimizerArg(a, 0),
  optimizer(
    { v | cond(guard(momentum = 0, { List() }), { (zerosLike(v),) }) },
    { g, v, s, t, lr | cond(
      guard(momentum = 0, { (v - lr×g, List()) }),
      { m: s_0 × momentum + g, (v - lr×m, (m,)) }) },
    lr, TensorOptimizerVars(a, b))
}), "sgd(lr, momentum?, vars?)", "Stochastic gradient descent, with optional momentum. A trailing list picks the variables to train.", "opt: sgd(0.01, 0.9)"),
; Adam's moments – running averages of the gradient and its square – and the same two
; bias-corrected for their start at 0, shared by its family
adamInit: OptimizerAdamInit: doc({ v | (zerosLike(v), zerosLike(v)) }, "adamInit", "Adam's slots for a variable – its two moments, zero to start – for optimizer(adamInit, …).", "opt: optimizer(adamInit, adamRule(0), 0.01)"),
TensorAdamMoments: { g, s, t, b1, b2 |
  m: g × (1 - b1) + (s_0 × b1),
  n: g × g × (1 - b2) + (s_1 × b2),
  (m, n, m ÷ (1 - b1^t), n ÷ (1 - b2^t))
},
adamRule: OptimizerAdamRule: doc({ wd | { g, v, s, t, lr |
  q: TensorAdamMoments(g, s, t, 0.9, 0.999),
  u: q_2 ÷ ((√q_3) + 1e-8) × (-lr),
  (v + cond(guard(wd = 0, { u }), { u + (v × -(lr × wd)) }), (q_0, q_1))
} }, "adamRule(weightDecay)", "Adam's update rule, for optimizer(adamInit, …): the moments of the gradient and its square, bias-corrected, and decoupled weight decay.", "opt: optimizer(adamInit, adamRule(0), 0.01)"),
adam: OptimizerAdam: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, adamRule(0), lr, a) }), "adam(lr, vars?)", "Adam: per-variable step sizes from running averages of the gradient and its square. A trailing list picks the variables to train.", "opt: adam(0.01)"),
adamw: OptimizerAdamW: doc(FunctionNoAutoLift({ lr, a, b | optimizer(adamInit, adamRule(TensorOptimizerArg(a, 1e-4)), lr, TensorOptimizerVars(a, b)) }),
  "adamw(lr, weightDecay?, vars?)", "Adam with decoupled weight decay. A trailing list picks the variables to train.", "opt: adamw(0.01, 0.001)"),
adagrad: OptimizerAdaGrad: doc(FunctionNoAutoLift({ lr, a | optimizer({ v | (zerosLike(v),) }, { g, v, s, t, lr |
  acc: g × g + s_0, (v - lr×(g ÷ ((√acc) + 1e-7)), (acc,))
}, lr, a) }), "adagrad(lr, vars?)", "AdaGrad: each variable's step shrinks with the gradients it has seen. A trailing list picks the variables to train.", "opt: adagrad(0.5)"),
rmsprop: OptimizerRMSProp: doc(FunctionNoAutoLift({ lr, a | optimizer({ v | (zerosLike(v),) }, { g, v, s, t, lr |
  n: s_0 × 0.9 + (g × g × 0.1), (v - lr×(g ÷ ((√n) + 1e-8)), (n,))
}, lr, a) }), "rmsprop(lr, vars?)", "RMSprop: steps divided by a running root-mean-square of the gradient.", "opt: rmsprop(0.01)"),
adadelta: OptimizerAdaDelta: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, { g, v, s, t, lr |
  e: s_0 × 0.9 + (g × g × 0.1),
  Δ: g × (√(s_1 + 1e-6) ÷ √(e + 1e-6)),
  (v - lr×Δ, (e, s_1 × 0.9 + (Δ × Δ × 0.1)))
}, lr, a) }), "adadelta(lr, vars?)", "Adadelta: steps in the units of the variable, from running averages of past gradients and past steps; lr 1 is the classic method.", "opt: adadelta(1)"),
adamax: OptimizerAdaMax: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, { g, v, s, t, lr |
  m: g × 0.1 + (s_0 × 0.9), u: s_1 × 0.999 ⌈ abs(g),
  (v - lr×(m ÷ (1 - 0.9^t) ÷ (u + 1e-8)), (m, u))
}, lr, a) }), "adamax(lr, vars?)", "Adamax: Adam with the infinity norm – steps divided by the largest recent gradient.", "opt: adamax(0.01)"),
nadam: OptimizerNAdam: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, { g, v, s, t, lr |
  q: TensorAdamMoments(g, s, t, 0.9, 0.999),
  mh: q_0 × 0.9 ÷ (1 - 0.9^(t+1)) + (g × 0.1 ÷ (1 - 0.9^t)),
  (v - lr×(mh ÷ ((√q_3) + 1e-8)), (q_0, q_1))
}, lr, a) }), "nadam(lr, vars?)", "NAdam: Adam with Nesterov momentum – the first moment looks one step ahead.", "opt: nadam(0.01)"),
radam: OptimizerRAdam: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, { g, v, s, t, lr |
  q: TensorAdamMoments(g, s, t, 0.9, 0.999),
  ρmax: 2 ÷ 0.001 - 1, ρ: ρmax - (2 × t × 0.999^t ÷ (1 - 0.999^t)),
  u: cond(
    guard(ρ ≥ 5, {
      ρ - 4 × (ρ - 2) × ρmax ÷ (ρmax - 4 × (ρmax - 2) × ρ) √ 2
        × (q_2 ÷ ((√q_3) + 1e-8))
    }),
    { q_2 }),
  (v - lr×u, (q_0, q_1))
}, lr, a) }), "radam(lr, vars?)", "RAdam: Adam whose adaptive step is switched in as its variance estimate becomes reliable – no warmup needed.", "opt: radam(0.01)"),
amsgrad: OptimizerAMSGrad: doc(FunctionNoAutoLift({ lr, a | optimizer({ v | (zerosLike(v), zerosLike(v), zerosLike(v)) }, { g, v, s, t, lr |
  ; the largest raw second moment, bias-corrected at this step – as PyTorch does
  q: TensorAdamMoments(g, s, t, 0.9, 0.999), top: s_2 ⌈ q_1,
  (v - lr×(q_2 ÷ (√(top ÷ (1 - 0.999^t)) + 1e-8)), (q_0, q_1, top))
}, lr, a) }), "amsgrad(lr, vars?)", "AMSGrad: Adam that divides by the largest second moment seen so far, so a step never grows from a forgotten large gradient.", "opt: amsgrad(0.01)"),
adabelief: OptimizerAdaBelief: doc(FunctionNoAutoLift({ lr, a | optimizer(adamInit, { g, v, s, t, lr |
  m: g × 0.1 + (s_0 × 0.9), d: g - m,
  b: d × d × 0.001 + (s_1 × 0.999) + 1e-16,
  (v - lr×(m ÷ (1 - 0.9^t) ÷ (√(b ÷ (1 - 0.999^t)) + 1e-16)), (m, b))
}, lr, a) }), "adabelief(lr, vars?)", "AdaBelief: Adam that divides by how far the gradient strays from its running average – large steps where the gradient is predictable.", "opt: adabelief(0.01)"),
yogi: OptimizerYogi: doc(FunctionNoAutoLift({ lr, a | optimizer({ v | (zerosLike(v), fill(shape(v), 1e-6)) }, { g, v, s, t, lr |
  m: g × 0.1 + (s_0 × 0.9), g2: g × g,
  n: s_1 - (sign(s_1 - g2) × g2 × 0.001),
  (v - lr×(m ÷ ((√n) + 1e-3)), (m, n))
}, lr, a) }), "yogi(lr, vars?)", "Yogi: Adam whose second moment moves additively, so it cannot blow up or vanish suddenly.", "opt: yogi(0.01)"),
lion: OptimizerLion: doc(FunctionNoAutoLift({ lr, a, b | wd: TensorOptimizerArg(a, 1e-3), optimizer({ v | (zerosLike(v),) }, { g, v, s, t, lr |
  c: s_0 × 0.9 + (g × 0.1),
  (v - lr×(sign(c) + (v × wd)), (s_0 × 0.99 + (g × 0.01),))
}, lr, TensorOptimizerVars(a, b)) }), "lion(lr, weightDecay?, vars?)", "Lion: the sign of an interpolated momentum – every step has the same size, lr; found by program search.", "opt: lion(0.001)"),
lamb: OptimizerLAMB: doc(FunctionNoAutoLift({ lr, a, b | wd: TensorOptimizerArg(a, 0), optimizer(adamInit, { g, v, s, t, lr |
  q: TensorAdamMoments(g, s, t, 0.9, 0.999),
  u: q_2 ÷ ((√q_3) + 1e-6) + (v × wd),
  pv: norm(v), pu: norm(u),
  trust: where(pv>0 ∧ pu>0, pv ÷ (pu ⌈ 1e-30), 1),
  (v - lr×(u × trust), (q_0, q_1))
}, lr, TensorOptimizerVars(a, b)) }), "lamb(lr, weightDecay?, vars?)", "LAMB: Adam rescaled per variable by the ratio of the variable's norm to its update's – large batches train stably.", "opt: lamb(0.01)"),
; Muon: momentum, then for a matrix its update made orthogonal – five Newton–Schulz
; steps to the nearest semi-orthogonal matrix; anything else steps as momentum SGD
TensorNewtonSchulz: { G |
  tall: shape(G)_0 > shape(G)_1,
  X0: cond(guard(tall, { transpose(G) }), { G }),
  X1: X0 ÷ (norm(X0) + 1e-7),
  step: { X |
    A: X matmul transpose(X),
    B: A × -4.775 + (A matmul A × 2.0315),
    X × 3.4445 + (B matmul X)
  },
  X: (step ⍣ 5)(X1),
  cond(guard(tall, { transpose(X) }), { X })
},
muon: OptimizerMuon: doc(FunctionNoAutoLift({ lr, a, b | momentum: TensorOptimizerArg(a, 0.95), optimizer({ v | (zerosLike(v),) }, { g, v, s, t, lr |
  m: s_0 × momentum + g, look: g + (m × momentum),
  u: cond(
    guard((#shape(v)) = 2, { TensorNewtonSchulz(look) × √(shape(v)_0 ÷ shape(v)_1 ⌈ 1) }),
    { look }),
  (v - lr×u, (m,))
}, lr, TensorOptimizerVars(a, b)) }), "muon(lr, momentum?, vars?)", "Muon: momentum whose update, for a matrix, is orthogonalized by Newton–Schulz steps – every direction of the matrix moves at the same rate. Other variables step as momentum SGD.", "opt: muon(0.02)"),

; Strings
StringLength: doc(StringLength, "StringLength(s)", "How many characters s has.", "StringLength(\"abc\") = 3"),
StringGet: doc(StringGet, "StringGet(s, i)", "The character at index i; a negative i counts from the end.", "StringGet(\"abc\", -1) = \"c\""),
StringGather: doc(StringGather, "StringGather(s, indices)", "The characters at the given indices, in that order, as a string.", "StringGather(\"abc\", [2, 0]) = \"ca\""),
StringTake: doc(StringTake, "StringTake(s, n)", "The first n characters; with a negative n, the last n.", "StringTake(\"hello\", -2) = \"lo\""),
StringDrop: doc(StringDrop, "StringDrop(s, n)", "All but the first n characters; with a negative n, all but the last n.", "StringDrop(\"hello\", 2) = \"llo\""),
StringReverse: doc(StringReverse, "StringReverse(s)", "s back to front.", "StringReverse(\"abc\") = \"cba\""),
StringConcat: identity(doc(StringConcat, "StringConcat(a, b, …)  ·  StringConcat(strings)", "Strings joined end to end – after the first, a value that isn't a string as the source that writes it. One list of strings joins the strings in it.", "StringConcat(\"ab\", \"cd\") = \"abcd\""), ""),
StringReduce: doc(StringReduce, "StringReduce(s, f, init?)", "Fold the characters left to right with f, from init or from the first character.", "StringReduce(\"abc\", { a, c | StringConcat(c, a) }) = \"cba\""),
StringScan: doc(StringScan, "StringScan(s, f, init?)", "The running fold of the characters, as a list: its last item is StringReduce(s, f).", "StringScan(\"abc\", StringConcat) = (\"a\", \"ab\", \"abc\")"),
StringToCodes: doc(StringToCodes, "StringToCodes(text)", "Text to a tensor of character codes – the door from strings into tensors.", "StringToCodes(\"abc\") = [97, 98, 99]"),
CodesToString: doc(CodesToString, "CodesToString(codes)", "A tensor of character codes back to text. Rounds first, so model outputs decode directly.", "CodesToString([104, 105]) = \"hi\""),
String: doc(StringLiteral, "String(x)", "The Fluent source that reproduces a value: CodeEvaluate(String(x)) is x again. A string comes back quoted, a list keeps its parens, a tensor keeps its rank. Exact for data; a signal or ~ round-trips to a new one, and a lambda needs its free names in scope.", "String([1, 2]) = \"[1, 2]\""),

; Cards for built-ins bound natively
ln: doc(TensorNaturalLogarithm, "ln(x)", "The natural logarithm – log to base e, the same as log(x).", "ln(1) = 0"),
CodeParse: doc(CodeParse, "CodeParse(text)", "Fluent source text as a syntax tree – a program as a value.", "CodeParse(\"1 + 2\")"),
CodeEvaluate: doc(CodeEvaluate, "CodeEvaluate(code)", "Run Fluent source text – or a quoted program – and give its value.", "CodeEvaluate(\"1 + 2\") = 3"),
FunctionArity: doc(FunctionArity, "FunctionArity((two, one))", "One function from two, chosen by how many arguments it gets: the first takes two, the second one – how + is add and abs.", "FunctionArity(({ x, y | x + y }, { x | -x }))(5) = -5"),
FunctionNoAutoLift: doc(FunctionNoAutoLift, "FunctionNoAutoLift(f)", "f, marked so a signal passed to it arrives as the signal itself – not its value, with the call re-run on every change.", "FunctionNoAutoLift({ s | s })"),
doc: FunctionDoc: doc(doc, "doc(f, signature, description, example)", "Attach a doc card to f – what hover shows – and give f back.", "double: doc({ x | x × 2 }, \"double(x)\", \"x twice\", \"double(2) = 4\")"),
SignalCreate: doc(SignalCreate, "SignalCreate(value)", "A signal holding value – read it with s(), write it with s(v). $(value) is the short form.", "s: SignalCreate(1), s() = 1"),
SignalComputed: doc(SignalComputed, "SignalComputed(thunk)", "A signal whose value is the thunk's, computed again whenever a signal the thunk reads changes. $({ … }) is the short form.", "a: $1, b: SignalComputed({ a() × 10 }), b() = 10"),
SignalRead: doc(SignalRead, "SignalRead(s)", "A signal's value – the same as s().", "s: $3, SignalRead(s) = 3"),
SignalUpdate: doc(SignalUpdate, "SignalUpdate(s, v)", "Write v into the signal s – the same as s(v).", "s: $3, SignalUpdate(s, 4), s() = 4"),
Storage: doc(Storage, "Storage(key)", "A signal kept in this browser under key: it survives a reload. It is ◌ until a saved value arrives; writing it saves the value – a variable's value at that moment, tensors, strings and lists of them – and writing ◌ forgets it. A checkpoint is one: save the weights and the optimizer's memory, and := puts them back.", "s: Storage(\"notes\"), s(\"hello\"), s() = \"hello\""),

; Misc
($): doc(Reactive, "$value", "Wrap a value in a signal (or a thunk in a computed signal). Read with x(), write with x(v).", "x: $0.5, x^2 = 0.25"),
(←): SignalWrite: doc(FunctionNoAutoLift({ s, v | SignalUpdate(s, v) }), "signal← value", "Write a value into a signal – same as signal(value), but reads left-to-right. Chains like any spaced operator: parenthesize compound values, s ← (a + b).", "x: $1, x← 9, x() = 9"),
