{
  "name": "fluent",
  "version": "0.0.1",
  "description": "reactive programming for differentiable tensors",
  "author": "Milan Lajtoš <hello@mlajtos.mu>",
  "license": "MIT",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun server.ts",
    "paper": "HOST=0.0.0.0 PORT=3211 FRONT_PORT=3210 TLS_CERT=paper/cert.pem TLS_KEY=paper/key.pem bun server.ts",
    "build": "bun build.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "bun test ./tests.ts",
    "test:engine": "bun engine/tests/index.bun.ts && bun engine/tests/fold.bun.ts && bun -e \"for (const f of ['core', 'ops']) if ((await (await import('./engine/tests/' + f + '.ts')).default()).fails) process.exit(1)\"",
    "test:browser": "npx playwright test",
    "hero": "node screenshot.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@preact/signals-core": "^1.12.1",
    "@preact/signals-react": "^3.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "js-base64": "^3.7.8",
    "monaco-editor": "^0.54.0",
    "ohm-js": "^17.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "tailwindcss": "^4.1.14",
    "ts-dedent": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/js-base64": "^3.3.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@webgpu/types": "^0.1.71",
    "bun-plugin-tailwind": "^0.1.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
